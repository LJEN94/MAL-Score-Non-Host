  document.head.appendChild(uiStyle);

  function element(tag, attrs = {}, text = '') {
    const el = document.createElement(tag);
    Object.entries(attrs).forEach(([k, v]) => {
      if (k === 'class') el.className = v;
      else if (k === 'style') el.style.cssText = v;
      else if (k.startsWith('on') && typeof v === 'function') el.addEventListener(k.slice(2), v);
      else if (v !== undefined && v !== null) el.setAttribute(k, String(v));
    });
    if (text !== '') el.textContent = text;
    return el;
  }
  function button(label, action, cls = '') {
    const b = element('button', { type: 'button', class: cls }, label);
    b.addEventListener('click', action);
    return b;
  }
  function rowCopy(label, description) {
    const copy = element('div');
    copy.append(element('div', {}, label));
    if (description) copy.append(element('div', { class: 'mis-muted' }, description));
    return copy;
  }
  function settingRow(label, description, value, onChange) {
    const row = element('div', { class: 'mis-row' });
    const sw = button('', () => onChange(!value), 'mis-switch');
    sw.setAttribute('role', 'switch');
    sw.setAttribute('aria-checked', String(value));
    sw.setAttribute('aria-label', label);
    row.append(rowCopy(label, description), sw);
    return row;
  }
  function selectRow(label, description, value, options, onChange) {
    const row = element('div', { class: 'mis-row' });
    const sel = element('select', { 'aria-label': label, class: 'mis-select' });
    options.forEach(([v, text]) => {
      const o = element('option', { value: v }, text);
      if (v === value) o.selected = true;
      sel.append(o);
    });
    sel.addEventListener('change', () => onChange(sel.value));
    row.append(rowCopy(label, description), sel);
    return row;
  }
  function openFile(accept, callback) {
    const input = element('input', { type: 'file', accept, style: 'display:none' });
    input.addEventListener('change', () => {
      const file = input.files && input.files[0];
      input.remove();
      if (file) callback(file);
    });
    document.body.append(input);
    input.click();
  }
  function downloadJson(name, data) {
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = element('a', { href: url, download: name });
    document.body.append(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 3000);
  }
  function clearChildren(node) {
    while (node.firstChild) node.removeChild(node.firstChild);
  }

  // Snapshot of the live cache, rebuilt only when something changed (not on every keystroke).
  function getCacheIndex() {
    if (!cacheIndex) cacheIndex = allKeys().map(k => ({ key: k, id: k.slice(PREFIX.length), entry: GM_getValue(k) }));
    return cacheIndex;
  }

  // Cheap to call often: results are memoised for 5 seconds.
  function cacheSummary(force) {
    if (force) invalidateCaches();
    if (summaryMemo && Date.now() - summaryMemo.at < 5000) return summaryMemo.value;
    let expired = 0;
    let scores = 0;
    let noScore = 0;
    let bytes = 0;
    const index = getCacheIndex();
    for (const { entry } of index) {
      if (!isFresh(entry)) expired++;
      if (validScore(entry?.score)) scores++;
      else noScore++;
      try { bytes += JSON.stringify(entry).length * 2; } catch (e) { /* ignore non-serialisable legacy entries */ }
    }
    const value = {
      total: index.length, expired, scores, noScore, bytes, bulk: bulkCount(), list: myList ? Object.keys(myList.items || {}).length : 0,
    };
    summaryMemo = { at: Date.now(), value };
    return value;
  }

  function renderDashboardStatus() {
    if (!dashboardStatus) return;
    if (taskState.active) {
      dashboardStatus.textContent = `${taskState.label}: ${taskState.message || 'Working…'}`;
    } else {
      const s = cacheSummary();
      dashboardStatus.textContent = `${s.total.toLocaleString()} cached · ${s.bulk.toLocaleString()} bulk · ${s.list.toLocaleString()} list entries`;
    }
    if (dashboardProgress) {
      dashboardProgress.hidden = !taskState.active;
      const pct = taskState.total > 0 ? Math.min(100, taskState.done / taskState.total * 100) : (taskState.active ? 8 : 0);
      dashboardProgress.firstElementChild.style.width = `${pct}%`;
    }
    if (dashboardProgressText) {
      dashboardProgressText.textContent = taskState.active
        ? `${taskState.message || taskState.label}${taskState.total ? ` · ${taskState.done}/${taskState.total}` : ''}`
        : taskState.message || 'Ready';
    }
  }

  function renderDashboardIfOpen() {
    if (dashboardRoot && !dashboardRoot.hidden) renderDashboard();
  }

  function updateSetting(patch, reload) {
    Object.assign(settings, patch);
    saveSettings();
    applySettings();
    refreshListBadges();
    refreshAllBadges();
    if (reload) location.reload();
    else renderDashboard();
  }

  function renderCacheResults() {
    if (!cacheResults) return;
    clearChildren(cacheResults);
    const query = cacheFilter.trim().toLowerCase();
    const matches = getCacheIndex().filter(x => !query || x.id.includes(query) || String(x.entry?.title || '').toLowerCase().includes(query));
    const pages = Math.max(1, Math.ceil(matches.length / CACHE_PAGE_SIZE));
    cachePage = Math.min(cachePage, pages - 1);
    const page = matches.slice(cachePage * CACHE_PAGE_SIZE, (cachePage + 1) * CACHE_PAGE_SIZE);
    if (!page.length) cacheResults.append(element('div', { class: 'mis-cache-item mis-muted' }, 'No matching cache entries.'));
    page.forEach(({ key, id, entry }) => {
      const item = element('div', { class: 'mis-cache-item' });
      const copy = element('div', { class: 'mis-cache-title' });
      copy.append(element('div', {}, entry?.title || id));
      copy.append(element('div', { class: 'mis-muted' }, `${id} · ${validScore(entry?.score) ? entry.score.toFixed(2) : 'No score'} · ${isFresh(entry) ? 'fresh' : 'expired'} · ${entry?.source || 'unknown source'} · ${entry?.t ? new Date(entry.t).toLocaleDateString() : 'unknown date'}`));
      item.append(copy, button('Refresh', () => forceRefresh(id, false)));
      item.append(button('Delete', () => {
        GM_deleteValue(key);
        invalidateCaches();
        renderCacheResults();
        renderDashboardStatus();
        toast('Cache entry deleted');
      }, 'danger'));
      cacheResults.append(item);
    });
    const pager = element('div', { class: 'mis-actions' });
    pager.append(button('Previous', () => { cachePage = Math.max(0, cachePage - 1); renderCacheResults(); }));
    pager.append(element('span', { class: 'mis-muted', style: 'align-self:center' }, `${matches.length.toLocaleString()} results · page ${cachePage + 1}/${pages}`));
    pager.append(button('Next', () => { cachePage = Math.min(pages - 1, cachePage + 1); renderCacheResults(); }));
    cacheResults.append(pager);
  }

  function statGrid(pairs) {
    const grid = element('div', { class: 'mis-grid' });
    pairs.forEach(([label, value]) => {
      const card = element('div', { class: 'mis-stat' });
      card.append(element('small', {}, label), element('b', {}, typeof value === 'string' ? value : Number(value).toLocaleString()));
      grid.append(card);
    });
    return grid;
  }

  function exportDiagnostics() {
    const report = {
      app: 'MAL Inline Scores', version: '4.5.5', exportedAt: new Date().toISOString(),
      selectedProvider: settings.apiProvider, automaticFailover: settings.autoFailover,
      providers: providerHealth,
      metrics: { ...metrics }, queueLength: queue.length,
      sources: lanes.map(l => ({ name: l.name, coolingDown: sourceCoolingDown(l), cooldownUntil: Number(GM_getValue(`meta:disabled:${l.name}`, 0)) || null })),
      cache: cacheSummary(true),
      preloadProgress: GM_listValues().filter(k => k.startsWith('meta:preload:')).map(k => ({ key: k, value: GM_getValue(k) })),
    };
    downloadJson('mal-inline-scores-diagnostics.json', report);
    toast('Diagnostics exported (no personal list titles included)');
  }

  function renderOverviewTab(body) {
    const s = cacheSummary(true);
    const size = s.bytes < 1048576 ? `${(s.bytes / 1024).toFixed(1)} KB` : `${(s.bytes / 1048576).toFixed(2)} MB`;
    body.append(statGrid([
      ['Live cache', s.total], ['Scored entries', s.scores], ['No score', s.noScore], ['Expired entries', s.expired],
      ['Bulk scores', s.bulk], ['My list', s.list], ['Queue', queue.length], ['Approx. cache size', size],
    ]));
    const cooling = lanes.map(l => `${l.name}: ${sourceCoolingDown(l) ? `cooldown until ${new Date(Number(GM_getValue(`meta:disabled:${l.name}`, 0))).toLocaleTimeString()}` : 'available'}`).join(' · ');
    body.append(element('div', { class: 'mis-note' }, `Sources — ${cooling}`));
    body.append(element('div', { class: 'mis-note' }, `API health — ${PROVIDER_ORDER.map(p => { const h = providerHealth[p]; return `${apiName(p)}: ${h.ok === null ? 'not tested this session' : h.ok ? `OK · ${h.ms} ms` : `failed · ${h.error}`}`; }).join(' · ')}`));
    const hitRate = metrics.lookups ? Math.round((metrics.cacheHits + metrics.bulkHits) / metrics.lookups * 100) : 0;
    body.append(element('div', { class: 'mis-note' }, `This tab session: ${metrics.lookups.toLocaleString()} score lookups · ${metrics.requests.toLocaleString()} queued fetches · ${metrics.cacheHits.toLocaleString()} cache hits · ${metrics.bulkHits.toLocaleString()} bulk hits (${hitRate}% answered locally) · ${metrics.retries.toLocaleString()} retries · ${metrics.failures.toLocaleString()} final failures`));
    const listRow = element('div', { class: 'mis-row' });
    listRow.append(rowCopy('Personal MAL list', myList ? `${myList.user} · ${s.list.toLocaleString()} anime · refreshed ${new Date(myList.t).toLocaleString()}` : 'No list imported yet'));
    body.append(listRow);
    const actions = element('div', { class: 'mis-actions' });
    actions.append(button('Refresh page scores', refreshVisibleScores, 'primary'));
    actions.append(button('Refresh my list', () => {
      if (!myList) { toast('Set your username in Settings first'); return; }
      importList(myList.user, false);
    }));
    actions.append(button('Export everything', exportEverything));
    actions.append(button('Export diagnostics', exportDiagnostics));
    body.append(actions);
  }

  function renderSettingsTab(body) {
    body.append(selectRow('Completed / dropped anime', 'What to do with anime already on your list as completed or dropped', settings.seen,
      [['dim', 'Dim them'], ['hide', 'Hide their rows'], ['off', 'Leave alone']], v => updateSetting({ seen: v })));
    body.append(selectRow('API provider', 'Used for individual score lookups and top/season preloads. Tenrai is a separately hosted, pre-cached alternative.', settings.apiProvider,
      [['jikan', 'Jikan API (api.jikan.moe)'], ['jikan-edge', 'Jikan Edge (jikan.lucashdo.com)'], ['tenrai', 'Tenrai (api.tenrai.org)']], v => updateSetting({ apiProvider: v }, true)));
    body.append(settingRow('Automatic API failover', 'If the selected provider times out, is throttled or returns a server error, try the other providers automatically. Successful provider choice remains unchanged.', settings.autoFailover, v => updateSetting({ autoFailover: v })));
    body.append(button('Test all API providers', testAllProviders));
    body.append(settingRow('Show manga scores', 'Include manga links (reloads the page)', settings.manga, v => updateSetting({ manga: v }, true)));
    body.append(settingRow('Detailed score tooltips', 'Include score count, rank, source and cache date', settings.tooltips, v => updateSetting({ tooltips: v })));
    body.append(settingRow('Compact badges', 'Smaller pills without the star', settings.compact, v => updateSetting({ compact: v })));
    body.append(settingRow('Floating launcher button', 'Turn off to open this panel from the Tampermonkey menu only', settings.launcher, v => updateSetting({ launcher: v })));
    body.append(element('div', { style: 'margin-top:14px;font-weight:700' }, 'Personal MAL username or list URL'));
    const field = element('input', { type: 'text', placeholder: 'MAL username or /animelist/ URL', value: myList?.user || '' });
    body.append(field);
    const actions = element('div', { class: 'mis-actions' });
    actions.append(button('Import / update list', () => {
      const user = parseUser(field.value);
      if (!user) { toast('Enter a valid MAL username or list URL'); return; }
      importList(user, false);
    }, 'primary'));
    actions.append(button('Remove list', () => {
      if (!confirm('Remove the saved personal list?')) return;
      myList = null;
      GM_deleteValue(LIST_KEY);
      refreshListBadges();
      renderDashboard();
      toast('Personal list removed');
    }, 'danger'));
    body.append(actions);
    body.append(element('div', { style: 'margin-top:14px;font-weight:700' }, 'Backup'));
    body.append(element('div', { class: 'mis-muted' }, 'One file with settings, your list, the live cache and the bulk database.'));
    const backup = element('div', { class: 'mis-actions' });
    backup.append(button('Export everything', exportEverything));
    backup.append(button('Restore from backup', () => openFile('.json,application/json', importEverythingFile)));
    body.append(backup);
  }

  function renderCacheTab(body) {
    const s = cacheSummary(true);
    body.append(statGrid([['Live entries', s.total], ['Expired', s.expired], ['Bulk anime', s.bulk], ['Scored', s.scores]]));
    const search = element('input', { type: 'search', placeholder: 'Search title or anime:ID…', value: cacheFilter, style: 'margin-top:12px' });
    search.addEventListener('input', () => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => {
        cacheFilter = search.value;
        cachePage = 0;
        renderCacheResults();
      }, 250);
    });
    body.append(search);
    cacheResults = element('div', { class: 'mis-cache-list' });
    body.append(cacheResults);
    renderCacheResults();
    const actions = element('div', { class: 'mis-actions' });
    actions.append(button('Import cache JSON', () => openFile('.json,application/json', importCacheFile)));
    actions.append(button('Export cache JSON', exportCache));
    actions.append(button('Clear expired', () => {
      let n = 0;
      allKeys().forEach(k => { if (!isFresh(GM_getValue(k))) { GM_deleteValue(k); n++; } });
      renderDashboard();
      toast(`Removed ${n} expired entries`);
    }));
    actions.append(button('Refresh expired', () => {
      let n = 0;
      allKeys().forEach(k => { if (!isFresh(GM_getValue(k))) { forceRefresh(k.slice(PREFIX.length), true); n++; } });
      toast(`Refreshing ${n} expired entries in the background`);
    }));
    actions.append(button('Clear live cache', () => {
      if (!confirm('Delete all live cached scores? Bulk scores will be kept.')) return;
      allKeys().forEach(k => GM_deleteValue(k));
      renderDashboard();
      toast('Live cache cleared');
    }, 'danger'));
    actions.append(button('Import bulk JSON', () => openFile('.json,application/json', importBulkFile)));
    actions.append(button('Export bulk JSON', () => {
      const out = exportBulkObject();
      downloadJson('mal-bulk-scores.json', out);
      toast(`Exported ${Object.keys(out).length.toLocaleString()} bulk entries`);
    }));
    actions.append(button('Clear bulk', () => {
      if (!confirm('Delete all bulk scores? Live cache will be kept.')) return;
      shardKeys().forEach(k => GM_deleteValue(k));
      GM_listValues().filter(k => k.startsWith(LEGACY_BULK_PREFIX)).forEach(k => GM_deleteValue(k));
      bulkCache.clear();
      legacyBulkPending = false;
      renderDashboard();
      toast('Bulk database cleared');
    }, 'danger'));
    body.append(actions);
  }

  function renderTasksTab(body) {
    body.append(element('div', { class: 'mis-muted' }, 'Long-running imports and preloads share one progress display. You can cancel between steps; a request already in flight may finish first.'));
    const actions = element('div', { class: 'mis-actions' });
    actions.append(button('Preload top anime', () => {
      const n = Math.max(25, Math.min(5000, Number(prompt('How many top anime? (25–5000)', '500')) || 0));
      if (n) preloadScores('/top/anime', Math.ceil(n / 25), 'Top anime preload');
    }));
    actions.append(button('Preload current season', () => preloadScores('/seasons/now', 20, 'Current season')));
    actions.append(button('Preload upcoming season', () => preloadScores('/seasons/upcoming', 20, 'Upcoming season')));
    actions.append(button('Cancel task', () => {
      if (!taskState.active) return;
      taskState.cancelled = true;
      taskState.message = 'Cancellation requested…';
      renderDashboardStatus();
      toast('Cancellation requested');
    }, 'danger'));
    body.append(actions);
    body.append(element('div', { class: 'mis-note' }, taskState.active ? `${taskState.label}: ${taskState.message}` : taskState.message || 'No task currently running'));
  }

  function renderDashboard() {
    if (!dashboardRoot) return;
    const body = dashboardRoot.querySelector('.mis-body');
    clearChildren(body);
    cacheResults = null;
    if (dashboardTab === 'overview') renderOverviewTab(body);
    else if (dashboardTab === 'settings') renderSettingsTab(body);
    else if (dashboardTab === 'cache') renderCacheTab(body);
    else renderTasksTab(body);
    renderDashboardStatus();
  }

  function buildDashboard() {
    launcherEl = button('MAL Scores', () => {
      dashboardRoot.hidden = !dashboardRoot.hidden;
      if (!dashboardRoot.hidden) renderDashboard();
    });
    launcherEl.id = 'mis-launcher';
    launcherEl.title = 'Open MAL Inline Scores settings';
    launcherEl.hidden = !settings.launcher;
    dashboardRoot = element('section', { id: 'mis-dashboard', hidden: '' });
    const head = element('div', { class: 'mis-head' });
    head.append(element('strong', {}, 'MAL Inline Scores'), element('span', { class: 'mis-grow' }));
    dashboardStatus = element('span', { class: 'mis-muted' }, 'Ready');
    head.append(dashboardStatus);
    head.append(button('×', () => { dashboardRoot.hidden = true; }));
    dashboardRoot.append(head);
    const tabs = element('nav', { class: 'mis-tabs', role: 'tablist' });
    [['overview', 'Overview'], ['settings', 'Settings'], ['cache', 'Cache'], ['tasks', 'Imports & preload']].forEach(([id, label]) => {
      const b = button(label, () => {
        dashboardTab = id;
        tabs.querySelectorAll('button').forEach(x => x.setAttribute('aria-selected', String(x.dataset.tab === id)));
        renderDashboard();
      });
      b.dataset.tab = id;
      b.setAttribute('role', 'tab');
      b.setAttribute('aria-selected', String(id === dashboardTab));
      tabs.append(b);
    });
    dashboardRoot.append(tabs);
    const progressWrap = element('div', { style: 'padding:0 14px 6px' });
    dashboardProgressText = element('div', { class: 'mis-muted' }, 'Ready');
    progressWrap.append(dashboardProgressText);
    dashboardProgress = element('div', { class: 'mis-progress', hidden: '' });
    dashboardProgress.append(element('div'));
    progressWrap.append(dashboardProgress);
    dashboardRoot.append(progressWrap);
    dashboardRoot.append(element('div', { class: 'mis-body' }));
    dashboardRoot.append(element('div', { class: 'mis-foot' }, 'MAL Inline Scores · selectable Jikan / Jikan Edge / Tenrai APIs · settings saved in Tampermonkey storage'));
    document.body.append(launcherEl, dashboardRoot);
    renderDashboard();
  }
  if (document.body) buildDashboard();
  else document.addEventListener('DOMContentLoaded', buildDashboard, { once: true });

  // Esc or a click outside closes the panel.
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && dashboardRoot && !dashboardRoot.hidden) dashboardRoot.hidden = true;
  });
  document.addEventListener('mousedown', e => {
    if (!dashboardRoot || dashboardRoot.hidden) return;
    if (dashboardRoot.contains(e.target) || e.target.closest?.('#mis-launcher')) return;
    dashboardRoot.hidden = true;
  }, true);

  // ---------- keep other tabs in sync ----------
  if (typeof GM_addValueChangeListener === 'function') {
    GM_addValueChangeListener(LIST_KEY, (name, oldValue, newValue, remote) => {
      if (!remote) return;
      myList = newValue || null;
      refreshListBadges();
      renderDashboardIfOpen();
    });
    GM_addValueChangeListener(SETTINGS_KEY, (name, oldValue, newValue, remote) => {
      if (!remote) return;
      const next = normaliseSettings(newValue);
      const mangaChanged = next.manga !== settings.manga;
      Object.assign(settings, next);
      applySettings();
      refreshListBadges();
      refreshAllBadges();
      if (!mangaChanged) renderDashboardIfOpen();
    });
  }

  GM_registerMenuCommand('Open MAL Inline Scores dashboard', () => {
    if (!dashboardRoot) return;
    dashboardRoot.hidden = false;
    renderDashboard();
  });
})();
